#include <winres.h>

#define IDI_APP_ICON 101
#define IDR_APP_ICON_SVG 102
#define IDR_APP_ICON_SMALL_SVG 103

// The window and shell icon (frames rendered from the SVGs by tools/make_icon.py).
IDI_APP_ICON ICON "assets/icon.ico"
// The same drawings as SVG text, rasterized by Facet for the title bar (ui/assets.cpp).
IDR_APP_ICON_SVG RCDATA "assets/icon.svg"
IDR_APP_ICON_SMALL_SVG RCDATA "assets/icon-small.svg"

// app.manifest is a source of the CMake target (app/CMakeLists.txt): the linker merges it into
// the manifest it embeds, so it must not also be embedded as a resource here.

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    2,0,0,0
    PRODUCTVERSION 2,0,0,0
    FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
    FILEFLAGS      0x1L
#else
    FILEFLAGS      0x0L
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "luminary"
            VALUE "FileDescription",  "Cleans Steam account residue and installs autoexec / video configs"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "steam-tracer-cleaner"
            VALUE "LegalCopyright",   "Copyright (c) 2026 luminary-cloud"
            VALUE "OriginalFilename", "steam-tracer-cleaner.exe"
            VALUE "ProductName",      "Steam Tracer Cleaner"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
