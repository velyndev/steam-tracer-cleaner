{
    "version": 5,
    "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "debug",
            "inherits": "base",
            "displayName": "Debug (x64, static CRT, Ninja, run from an x64 developer prompt)",
            "generator": "Ninja",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release (x64, static CRT, Ninja, run from an x64 developer prompt)",
            "generator": "Ninja",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "vs2026",
            "inherits": "base",
            "displayName": "Visual Studio 2026 (x64, multi-config, used by CI)",
            "generator": "Visual Studio 18 2026",
            "architecture": { "value": "x64", "strategy": "set" }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" },
        { "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug" },
        { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release" }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        { "name": "debug", "inherits": "test-base", "configurePreset": "debug" },
        { "name": "release", "inherits": "test-base", "configurePreset": "release" },
        { "name": "vs2026-debug", "inherits": "test-base", "configurePreset": "vs2026", "configuration": "Debug" },
        { "name": "vs2026-release", "inherits": "test-base", "configurePreset": "vs2026", "configuration": "Release" }
    ]
}
